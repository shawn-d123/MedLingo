# Copy to .env.local and fill in. Never commit .env.local.
FAL_KEY=
OPENAI_API_KEY=

# Person B — reading & language
TAVILY_API_KEY=
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
# PIONEER_GLINER_MODEL=       # from Pioneer dashboard GET /base-models; step skipped if unset

# Hosted URL of the illustrated presenter image (npm run presenter generates one)
PRESENTER_IMAGE_URL=

# Optional
# TTS_PROVIDER=openai          # force the OpenAI TTS fallback instead of Fal
# FAL_TTS_ENDPOINT=fal-ai/qwen-3-tts
# FAL_TTS_VOICE=Cherry
# OPENAI_TTS_VOICE=nova
# VIDEO_RESOLUTION=480p        # 720p if time allows
# MOCK_PIPELINE=1              # skip all external calls, write stub URLs (UI work without credits)
