# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---------------------------------------------------------------
# Reads the prescription photo, writes and translates the script, TTS fallback.
OPENAI_API_KEY=
# Speech (ElevenLabs on Fal) and video (VEED Fabric on Fal). Keys are tried in
# order and the pipeline rolls to the next automatically when one is exhausted,
# so FAL_KEY_2/3 are optional spares.
FAL_KEY=
FAL_KEY_2=
FAL_KEY_3=
# Set by `npm run presenter`; the hosted image the presenter is generated from.
PRESENTER_IMAGE_URL=

# --- Recommended ------------------------------------------------------------
# Grounds each drug's description in its official patient information leaflet.
# Without it the pipeline still runs, but the script is model-memory only.
TAVILY_API_KEY=
TAVILY_API_KEY_2=

# One presenter per language; falls back to PRESENTER_IMAGE_URL when unset.
PRESENTER_IMAGE_URL_UR=
PRESENTER_IMAGE_URL_PL=

# --- Optional ---------------------------------------------------------------
# Structured-extraction cleanup via Fastino's Pioneer (OpenAI-compatible).
# Skipped gracefully when unset or when the account has no billing enabled.
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
PIONEER_GLINER_MODEL=fastino/Fastino-Nemotron-3.5-Lightning-Healthcare

# Origin allowed to call this API (the web app).
WEB_ORIGIN=http://localhost:8080

# Hard cap on spoken length; render time scales with audio duration.
MAX_SPOKEN_SECONDS=25
# 480p renders in roughly half the time of 720p.
VIDEO_RESOLUTION=480p
VIDEO_TIMEOUT_MS=900000

# TTS_PROVIDER=openai        # force the OpenAI fallback instead of Fal
# FAL_TTS_ENDPOINT=fal-ai/elevenlabs/tts/eleven-v3
# FAL_TTS_VOICE=Rachel
# OPENAI_TTS_VOICE=nova
# MOCK_PIPELINE=1            # stub every external call — UI work without spending credits
